{
  "name": "undery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build-info.mjs && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:integration": "node scripts/verify-production.mjs",
    "release:package": "python3 scripts/package-release.py",
    "test:deploy": "python3 -m unittest discover -s tests/deploy -v"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "^5.9.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}

